# Weather Explorer backend on Replit.
# Deploy as a Reserved VM (always on: chat connections, scheduled sweeps). Secrets to add in Replit:
#   ANTHROPIC_API_KEY  (Claude guide and highlights sweeps)
#   APP_KEY            (the key built into the iPhone/iPad app)
# Attach an Object Storage bucket so the highlights feed survives restarts.
# uv installs into Replit's own environment (.pythonlibs), so start everything with `uv run`.
modules = ["python-3.12"]
run = "uv run --frozen uvicorn server:app --host 0.0.0.0 --port 8000"

[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "uv sync --frozen"]
run = ["sh", "-c", "uv run --frozen uvicorn server:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
